#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_lock {
            bindings = <&to 4>;
            key-positions = <35 24>;
        };

        combo_release {
            bindings = <&to 0>;
            key-positions = <11 23 0 12>;
        };
    };

    macros {
        macro_parenthesis: macro_parenthesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "MACRO_PARENTHESIS";
        };

        macro_brackets: macro_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "MACRO_BRACKETS";
        };

        macro_quote: macro_quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp DOUBLE_QUOTES &kp LEFT>;
            label = "MACRO_QUOTES";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp MINUS      &kp Q  &kp W  &kp E                 &kp R                    &kp T          &kp Y        &kp U                   &kp I                 &kp O       &kp P     &kp EQUAL
&kp BACKSLASH  &kp A  &kp S  &kp D                 &kp F                    &kp G          &kp H        &kp J                   &kp K                 &kp L       &kp SEMI  &kp SQT
&kp AT_SIGN    &kp Z  &kp X  &kp C                 &kp V                    &kp B          &kp N        &kp M                   &kp COMMA             &kp PERIOD  &kp FSLH  &kp EXCLAMATION
                             &mt LEFT_CONTROL TAB  &mt LEFT_SHIFT CAPSLOCK  &lt 2 ENTER    &lt 1 SPACE  &mt LEFT_GUI BACKSPACE  &mt RIGHT_ALT ESCAPE
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&trans  &trans  &trans  &trans      &kp C_VOLUME_UP   &kp C_MUTE    &kp HOME  &kp UP_ARROW  &kp PAGE_UP               &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9
&trans  &trans  &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT    &kp LEFT  &kp DOWN      &kp RIGHT                 &kp NUMBER_4  &kp N5        &kp NUMBER_6
&trans  &trans  &trans  &trans      &kp C_VOL_DN      &trans        &kp END   &trans        &kp PAGE_DOWN             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3
                        &trans      &kp LG(SPACE)     &mo 3         &trans    &kp DELETE    &kp LC(LG(LS(NUMBER_4)))
            >;
        };

        Raise {
            bindings = <
&kp LC(LA(LEFT))  &kp LC(LA(RIGHT))  &kp LG(D)             &kp LG(LS(BACKSLASH))  &kp LG(T)              &msc SCRL_UP      &kp C_AC_HOME     &kp PAGE_UP        &kp END            &kp AMPERSAND    &kp ASTERISK  &macro_parenthesis
&kp LA(LC(E))     &kp LA(LC(G))      &kp LG(LEFT_BRACKET)  &kp LG(L)              &kp LG(RIGHT_BRACKET)  &msc SCRL_DOWN    &kp LA(LEFT)      &kp PAGE_DOWN      &kp LA(RIGHT)      &kp DOLLAR       &kp PERCENT   &kp CARET
&kp LA(LC(R))     &kp LA(LC(F))      &kp LC(LG(F))         &trans                 &trans                 &trans            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans             &kp EXCLAMATION  &kp AT_SIGN   &kp HASH
                                                           &kp LG(LS(NUMBER_3))   &kp LC(LG(SPACE))      &trans            &mo 3             &kp RS(RG(SPACE))  &kp LA(LC(LG(X)))
            >;

            label = "Raise";
        };

        system {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans         &trans        &trans        &bt BT_CLR_ALL
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans         &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2
                        &trans  &trans  &trans    &trans  &trans  &kp LC(LG(Q))
            >;

            label = "system";
        };

        lock {
            bindings = <
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;

            label = "LOCKED";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
